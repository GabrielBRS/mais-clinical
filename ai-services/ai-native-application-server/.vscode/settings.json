{
    "files.associations": {
        "*.mojo": "mojo",
        "*.🔥": "mojo"
    },
    "files.watcherExclude": {
        "**/.pixi/**": true,
        "**/.venv/**": true,
        "**/target/**": true,
        "**/build/**": true
    },
    "search.exclude": {
        "**/.pixi/**": true,
        "**/.venv/**": true,
        "**/target/**": true,
        "**/build/**": true
    },

    "rust-analyzer.linkedProjects": [
        "Cargo.toml"
    ],
    "rust-analyzer.cargo.buildScripts.enable": true,
    "rust-analyzer.procMacro.enable": true,
    "rust-analyzer.cargo.targetDir": true,
    "rust-analyzer.files.excludeDirs": [
        ".pixi",
        ".venv",
        "build",
        "src/ai_orchestrator"
    ],
    "rust-analyzer.server.extraEnv": {
        "PATH": "${env:HOME}/.cargo/bin:${env:PATH}"
    },
    "rust-analyzer.cargo.extraEnv": {
        "PATH": "${env:HOME}/.cargo/bin:${env:PATH}"
    },
    "[rust]": {
        "editor.defaultFormatter": "rust-lang.rust-analyzer",
        "editor.formatOnSave": true
    },

    "mojo.preferWorkspaceEnv": true,
    "mojo.lsp.includeDirs": [
        "src",
        "/home/gabrielsousa/workspace/orzyon_omai(health)/ai-services/ai-native-application-server/src"
    ],
    "[mojo]": {
        "editor.defaultFormatter": "modular-mojotools.vscode-mojo",
        "editor.formatOnSave": true
    },

    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python.analysis.extraPaths": [
        "src"
    ],
    "python.autoComplete.extraPaths": [
        "src"
    ],
    "python.analysis.autoSearchPaths": true,
    "python.analysis.diagnosticMode": "workspace",
    "python.analysis.indexing": true,
    "python.testing.pytestEnabled": true,
    "python.testing.pytestArgs": [
        "tests"
    ],
    "cursorpyright.analysis.extraPaths": [
        "src"
    ],
    "cursorpyright.analysis.autoSearchPaths": true,
    "cursorpyright.analysis.diagnosticMode": "workspace",
    "cursorpyright.analysis.exclude": [
        "**/.pixi/**",
        "**/.venv/**",
        "**/target/**",
        "**/build/**",
        "src/domain/**",
        "src/application/**",
        "src/bootstrap/**",
        "src/transport/**",
        "src/infrastructure/**"
    ]
}
