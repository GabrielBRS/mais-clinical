{
    "files.associations": {
        "*.mojo": "mojo",
        "*.🔥": "mojo"
    },
    "files.watcherExclude": {
        "**/.pixi/**": true,
        "**/.venv/**": true,
        "**/target/**": true,
        "**/build/**": true,
        "**/builds/**": true
    },
    "search.exclude": {
        "**/.pixi/**": true,
        "**/.venv/**": true,
        "**/target/**": true,
        "**/build/**": true,
        "**/builds/**": true
    },

    "rust-analyzer.linkedProjects": [
        "ai-native-application-server/Cargo.toml"
    ],
    "rust-analyzer.cargo.buildScripts.enable": true,
    "rust-analyzer.procMacro.enable": true,
    "rust-analyzer.cargo.targetDir": true,
    "rust-analyzer.files.excludeDirs": [
        ".pixi",
        ".venv",
        "build",
        "builds",
        "ai-agent-contract/src/ai_orchestrator"
    ],
    "rust-analyzer.server.extraEnv": {
        "PATH": "${env:HOME}/.cargo/bin:${env:PATH}"
    },
    "rust-analyzer.cargo.extraEnv": {
        "PATH": "${env:HOME}/.cargo/bin:${env:PATH}"
    },
    "[rust]": {
        "editor.defaultFormatter": "rust-lang.rust-analyzer",
        "editor.formatOnSave": true
    },

    "mojo.preferWorkspaceEnv": true,
    "mojo.lsp.includeDirs": [
        "ai-agent-runtime/src"
    ],
    "[mojo]": {
        "editor.defaultFormatter": "modular-mojotools.vscode-mojo",
        "editor.formatOnSave": true
    },

    "python.defaultInterpreterPath": "${workspaceFolder}/ai-agent-contract/.venv/bin/python",
    "python.analysis.extraPaths": [
        "ai-agent-contract/src"
    ],
    "python.autoComplete.extraPaths": [
        "ai-agent-contract/src"
    ],
    "python.analysis.autoSearchPaths": true,
    "python.analysis.diagnosticMode": "workspace",
    "python.analysis.indexing": true,
    "python.testing.pytestEnabled": true,
    "python.testing.cwd": "${workspaceFolder}/ai-agent-contract",
    "python.testing.pytestArgs": [
        "../ai-native-application-server/tests"
    ],
    "cursorpyright.analysis.extraPaths": [
        "ai-agent-contract/src"
    ],
    "cursorpyright.analysis.autoSearchPaths": true,
    "cursorpyright.analysis.diagnosticMode": "workspace",
    "cursorpyright.analysis.exclude": [
        "**/.pixi/**",
        "**/.venv/**",
        "**/target/**",
        "**/build/**",
        "**/builds/**",
        "ai-agent-runtime/**"
    ]
}
