set dotenv-load := false

default:
    @just --list

generate-contract-loaders:
    uv run --frozen python scripts/generate_agent_contract_loaders.py

format:
    cargo fmt --all
    pixi run --manifest-path ai-agent-runtime/pixi.toml format

lint:
    cargo fmt --all -- --check
    cargo clippy --all-targets -- -D warnings

test:
    cargo test
    pixi run --manifest-path ai-agent-runtime/pixi.toml test
    cargo build --locked
    pixi run --manifest-path ai-agent-runtime/pixi.toml build
    uv run --frozen python -m pytest

build:
    cargo build --locked --release -p ai-native-runtime
    pixi run --manifest-path ai-agent-runtime/pixi.toml build

run:
    cargo run --locked -p ai-native-runtime

run-agent:
    pixi run --manifest-path ai-agent-runtime/pixi.toml run

docker-runtime:
    docker build -f Dockerfile -t orzyon/ai-native-runtime:0.1.0 .

docker-agent-runtime:
    docker build -f ai-agent-runtime/Dockerfile -t orzyon/ai-agent-runtime:0.1.0 .

compose-up:
    docker compose up --build

compose-down:
    docker compose down
