set dotenv-load := false

default:
    @just --list

generate-contract-loaders:
    uv run --project ai-agent-contract --frozen python scripts/generate_agent_contract_loaders.py

format:
    cargo fmt --all --manifest-path ai-native-application-server/Cargo.toml
    pixi run --manifest-path ai-agent-runtime/pixi.toml format

lint:
    cargo fmt --all --manifest-path ai-native-application-server/Cargo.toml -- --check
    cargo clippy --manifest-path ai-native-application-server/Cargo.toml --all-targets -- -D warnings

test:
    cargo test --manifest-path ai-native-application-server/Cargo.toml
    pixi run --manifest-path ai-agent-runtime/pixi.toml test
    cargo build --locked --manifest-path ai-native-application-server/Cargo.toml
    pixi run --manifest-path ai-agent-runtime/pixi.toml build
    uv run --project ai-agent-contract --directory ai-agent-contract --frozen python -m pytest

build:
    python build.py

deploy:
    python deploy.py

run:
    cargo run --locked --manifest-path ai-native-application-server/Cargo.toml -p ai-native-runtime

run-agent:
    pixi run --manifest-path ai-agent-runtime/pixi.toml run

docker-runtime:
    docker build -f Dockerfile -t orzyon/ai-native-runtime:0.1.0 .

docker-agent-runtime:
    docker build -f ai-agent-runtime/Dockerfile -t orzyon/ai-agent-runtime:0.1.0 .

compose-up:
    docker compose up --build

compose-down:
    docker compose down
