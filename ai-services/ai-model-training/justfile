set dotenv-load := false

default:
    @just --list

setup:
    pixi install --frozen
    pixi run setup

format:
    pixi run format

lint:
    pixi run lint

test-python:
    pixi run test-python

test-mojo:
    pixi run test-mojo

test-contract:
    pixi run test-contract

test-integration:
    pixi run test-integration

test-smoke:
    pixi run test-smoke

test:
    pixi run test

build:
    pixi run build

run *args:
    pixi run ai-model-training {{args}}

prepare recipe="recipes/qwen/sft_lora.yaml":
    pixi run ai-model-training prepare-data --recipe {{recipe}}

train recipe="recipes/qwen/sft_lora.yaml":
    pixi run ai-model-training train --recipe {{recipe}}

evaluate recipe="recipes/qwen/sft_lora.yaml":
    pixi run ai-model-training evaluate --recipe {{recipe}}

export recipe="recipes/qwen/sft_lora.yaml":
    pixi run ai-model-training export --recipe {{recipe}}

train-smoke:
    pixi run train-smoke

docker-build:
    pixi run docker-build

docker-smoke:
    pixi run docker-smoke

benchmark:
    pixi run benchmark
