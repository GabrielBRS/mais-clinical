{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["replicaCount", "image", "existingSecret", "resources"],
  "properties": {
    "replicaCount": {"type": "integer", "minimum": 1},
    "existingSecret": {"type": "string", "minLength": 1},
    "image": {"type": "object", "required": ["repository", "tag"], "properties": {
      "repository": {"type": "string", "minLength": 1},
      "tag": {"type": "string", "minLength": 1, "not": {"enum": ["latest"]}}
    }},
    "service": {"type": "object", "properties": {"port": {"type": "integer", "minimum": 1024, "maximum": 65535}}}
  }
}
