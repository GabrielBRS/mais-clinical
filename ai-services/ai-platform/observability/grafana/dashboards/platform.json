{
  "uid": "orzyon-platform", "title": "Orzyon Platform", "schemaVersion": 40,
  "version": 1, "refresh": "15s", "time": {"from": "now-30m", "to": "now"},
  "panels": [
    {"id": 1, "type": "timeseries", "title": "HTTP responses / s", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}, "targets": [{"refId": "A", "expr": "sum(rate(orzyon_http_requests_total[5m])) by (status)", "legendFormat": "{{status}}"}]},
    {"id": 2, "type": "timeseries", "title": "MCP tool p95 seconds", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum(rate(orzyon_tool_seconds_bucket[5m])) by (le, tool))", "legendFormat": "{{tool}}"}]},
    {"id": 3, "type": "timeseries", "title": "Tool outcomes / s", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}, "targets": [{"refId": "A", "expr": "sum(rate(orzyon_tool_calls_total[5m])) by (tool, outcome)", "legendFormat": "{{tool}} {{outcome}}"}]},
    {"id": 4, "type": "stat", "title": "Scrape health", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}, "targets": [{"refId": "A", "expr": "up{job=\"orzyon\"}"}]}
  ]
}
